{
  "manifest_version": 3,
  "name": "Tab Observatory",
  "description": "Inspect Chrome process memory, CPU and tab associations with a local companion.",
  "version": "0.2.0",
  "minimum_chrome_version": "125",
  "permissions": [
    "tabs",
    "debugger",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Tab Observatory",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
